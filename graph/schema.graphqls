# See https://gqlgen.com/getting-started/ for tutorial

type Bookmark {
  url: String!
  name: String!
  desc: String!
}

type Query {
  bookmarks(folder: String!): [Bookmark!]!
}

input NewBookmark {
  url: String!
  name: String
  desc: String
  parent: NewFolder
}

input NewFolder {
  name: String!
  desc: String
  parent: NewFolder
}

type Folder {
  name: String!
  child: Folder
  desc: String
}

type Mutation {
  createBookmark(input: NewBookmark!): Bookmark!
  createFolder(input: NewFolder!): Folder!
}
