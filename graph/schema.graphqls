# See https://gqlgen.com/getting-started/ for tutorial

type Bookmark {
  url: String!
  name: String!
  desc: String!
}

type Query {
  bookmarks(folder: String!): [Bookmark!]!
  folders: [FlatFolder!]!
}

interface BookmarkOrFolder {
  name: String
  desc: String
}

input NewBookmark {
  url: String!
  name: String
  desc: String
  parent: String!
}

input NewFolder {
  name: String!
  desc: String!
  parent: String!
}

type Folder {
  name: String!
  children: [Bookmark]
  subfolders: [Folder]
  desc: String
  parent: String
}

type FlatFolder {
  name: String!
  guid: String!
  child: String
}

type Mutation {
  createBookmark(input: NewBookmark!): Bookmark!
  createFolder(input: NewFolder!): Boolean!
}
